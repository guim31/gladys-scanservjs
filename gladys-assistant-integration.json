{
  "manifest_version": 1,
  "type": "device",
  "name": "scanservjs",
  "description": {
    "en": "Scan from Gladys with scanservjs: one tap or a scene, and an event when the file is ready.",
    "fr": "Numérisez depuis Gladys avec scanservjs : bouton ou scène, et un événement quand le fichier arrive.",
    "de": "Scanne aus Gladys mit scanservjs: per Knopf oder Szene, und ein Ereignis, wenn die Datei fertig ist.",
    "es": "Escanee desde Gladys con scanservjs: botón o escena, y un evento cuando el archivo está listo."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-scanservjs:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-scanservjs/main/cover.png",
  "categories": ["services", "appliances"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your scanservjs",
        "fr": "Votre scanservjs",
        "de": "Dein scanservjs",
        "es": "Su scanservjs"
      },
      "description": {
        "en": "scanservjs, the web interface that scans with SANE. Enter its address, and a user and password if its basic authentication is on. Then add the scanners from the Discover tab.",
        "fr": "scanservjs, l'interface web qui numérise avec SANE. Saisissez son adresse, et un utilisateur et un mot de passe si son authentification est activée. Ajoutez ensuite les scanners depuis l'onglet Découverte.",
        "de": "scanservjs, die Weboberfläche, die mit SANE scannt. Gib seine Adresse ein und, wenn seine Anmeldung aktiv ist, Benutzer und Passwort. Lege dann die Scanner im Tab „Entdecken“ an.",
        "es": "scanservjs, la interfaz web que escanea con SANE. Introduzca su dirección y, si su autenticación está activada, un usuario y una contraseña. Después añada los escáneres desde la pestaña Descubrir."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-scanservjs/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Einrichtungsanleitung",
            "es": "Guía de instalación"
          }
        },
        {
          "url": "https://github.com/sbs20/scanservjs",
          "label": {
            "en": "scanservjs documentation",
            "fr": "Documentation de scanservjs",
            "de": "scanservjs-Dokumentation",
            "es": "Documentación de scanservjs"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "scanservjs address",
        "fr": "Adresse de scanservjs",
        "de": "scanservjs-Adresse",
        "es": "Dirección de scanservjs"
      },
      "description": {
        "en": "The address of the web interface, port 8080 by default.",
        "fr": "L'adresse de l'interface web, port 8080 par défaut.",
        "de": "Die Adresse der Weboberfläche, standardmäßig Port 8080.",
        "es": "La dirección de la interfaz web, puerto 8080 por defecto."
      },
      "placeholder": {
        "en": "e.g. http://192.168.1.2:8080",
        "fr": "ex. http://192.168.1.2:8080",
        "de": "z. B. http://192.168.1.2:8080",
        "es": "p. ej. http://192.168.1.2:8080"
      },
      "required": true
    },
    {
      "key": "username",
      "type": "string",
      "label": {
        "en": "Username",
        "fr": "Nom d'utilisateur",
        "de": "Benutzername",
        "es": "Usuario"
      },
      "description": {
        "en": "A user of config.local.js (users). Empty without authentication.",
        "fr": "Un utilisateur de config.local.js (users). Vide sans authentification.",
        "de": "Ein Benutzer aus config.local.js (users). Leer ohne Anmeldung.",
        "es": "Un usuario de config.local.js (users). Vacío sin autenticación."
      },
      "required": false
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe",
        "de": "Passwort",
        "es": "Contraseña"
      },
      "description": {
        "en": "The password of this user. Empty without authentication.",
        "fr": "Le mot de passe de cet utilisateur. Vide sans authentification.",
        "de": "Das Passwort dieses Benutzers. Leer ohne Anmeldung.",
        "es": "La contraseña de este usuario. Vacía sin autenticación."
      },
      "required": false
    },
    {
